fix 1 all npt temp 574.999014285679 584.998989642821 $(100*dt) iso ${press} ${press} $(1000*dt)
fix 1 all npt temp 574.999014285679 584.998989642821 100 iso ${press} ${press} $(1000*dt)
fix 1 all npt temp 574.999014285679 584.998989642821 100 iso 1 ${press} $(1000*dt)
fix 1 all npt temp 574.999014285679 584.998989642821 100 iso 1 1 $(1000*dt)
fix 1 all npt temp 574.999014285679 584.998989642821 100 iso 1 1 1000

run ${run_steps} post no
