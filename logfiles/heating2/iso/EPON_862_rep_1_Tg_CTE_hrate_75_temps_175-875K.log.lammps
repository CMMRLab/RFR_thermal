variable run_steps delete
variable remaining_steps delete

jump SELF loop

variable remaining_steps equal v_steps-step
variable run_steps equal v_write_steps

if "${remaining_steps} < ${write_steps}" then    "variable run_steps delete"    "variable run_steps equal v_remaining_steps"

if "${run_steps} <= 0" then "jump SELF ramp_done"

variable Tstart equal ${stemp}+v_dTdS*step
variable Tstart equal 175+v_dTdS*step
variable Tfinal equal ${stemp}+v_dTdS*(step+v_run_steps)
variable Tfinal equal 175+v_dTdS*(step+v_run_steps)

fix 1 all npt temp ${Tstart} ${Tfinal} $(100*dt) iso ${press} ${press} $(1000*dt)
fix 1 all npt temp 244.999827499994 ${Tfinal} $(100*dt) iso ${press} ${press} $(1000*dt)
fix 1 all npt temp 244.999827499994 254.999802857136 $(100*dt) iso ${press} ${press} $(1000*dt)
fix 1 all npt temp 244.999827499994 254.999802857136 100 iso ${press} ${press} $(1000*dt)
fix 1 all npt temp 244.999827499994 254.999802857136 100 iso 1 ${press} $(1000*dt)
fix 1 all npt temp 244.999827499994 254.999802857136 100 iso 1 1 $(1000*dt)
fix 1 all npt temp 244.999827499994 254.999802857136 100 iso 1 1 1000

run ${run_steps} post no
run 133333 post no
