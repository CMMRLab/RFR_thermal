#--------Heating aneal sim------------
# reset timestep (for hrate compute)
reset_timestep   0
dump             1 all custom $(10*v_log_freq) ${myid}.dump id type x y z fx fy fz ix iy iz vx vy vz xu yu zu mass # every 10*${log_freq}
dump             1 all custom 13330 ${myid}.dump id type x y z fx fy fz ix iy iz vx vy vz xu yu zu mass 
dump             1 all custom 13330 PEEK_rep_4_Tg_CTE_hrate_75_temps_175-875K.dump id type x y z fx fy fz ix iy iz vx vy vz xu yu zu mass 
dump_modify      1 pbc yes # ensure atom postions in dump are within the simulation cell

# Determine total steps required for temperature ramp
variable         steps equal abs(round(1000000/dt*(${etemp}-${stemp})/${hrate}))
variable         steps equal abs(round(1000000/dt*(875-${stemp})/${hrate}))
variable         steps equal abs(round(1000000/dt*(875-175)/${hrate}))
variable         steps equal abs(round(1000000/dt*(875-175)/75))
variable         dTdS  equal (${etemp}-${stemp})/${steps}
variable         dTdS  equal (875-${stemp})/${steps}
variable         dTdS  equal (875-175)/${steps}
variable         dTdS  equal (875-175)/9333333

# Set temperatures for each loop iteration
variable         write_steps equal round(1000000/dt*(${wtemp}/${hrate})) # Total number of steps per loop iteration
variable         write_steps equal round(1000000/dt*(10/${hrate})) 
variable         write_steps equal round(1000000/dt*(10/75)) 
variable         Niter equal ceil(${steps}/${write_steps})               # Total number of loop iterations
variable         Niter equal ceil(9333333/${write_steps})               
variable         Niter equal ceil(9333333/133333)               
variable         Tstart equal ${stemp}+(${dTdS}*step)                    # Temp at start of loop iteration
variable         Tstart equal 175+(${dTdS}*step)                    
variable         Tstart equal 175+(7.50000026785715e-05*step)                    
variable         Tfinal equal ${stemp}+(${dTdS}*(step+${write_steps}))   # Temp at end of loop iteration
variable         Tfinal equal 175+(${dTdS}*(step+${write_steps}))   
variable         Tfinal equal 175+(7.50000026785715e-05*(step+${write_steps}))   
variable         Tfinal equal 175+(7.50000026785715e-05*(step+133333))   

# Set ensemble
fix              1 all npt temp ${Tstart} ${Tfinal} $(100*dt) iso ${press} ${press} $(1000*dt)
fix              1 all npt temp 175 ${Tfinal} $(100*dt) iso ${press} ${press} $(1000*dt)
fix              1 all npt temp 175 184.999975357142 $(100*dt) iso ${press} ${press} $(1000*dt)
fix              1 all npt temp 175 184.999975357142 100 iso ${press} ${press} $(1000*dt)
fix              1 all npt temp 175 184.999975357142 100 iso 1 ${press} $(1000*dt)
fix              1 all npt temp 175 184.999975357142 100 iso 1 1 $(1000*dt)
fix              1 all npt temp 175 184.999975357142 100 iso 1 1 1000

# Compute averages related to thermal properties
variable         dens equal density
variable         temp equal temp
variable         vol  equal vol
variable         lxx  equal lx
variable         lyy  equal ly
variable         lzz  equal lz

fix              dens_ave all ave/time 1 ${log_freq} ${log_freq} v_dens
fix              dens_ave all ave/time 1 1333 ${log_freq} v_dens
fix              dens_ave all ave/time 1 1333 1333 v_dens
fix              temp_ave all ave/time 1 ${log_freq} ${log_freq} v_temp
fix              temp_ave all ave/time 1 1333 ${log_freq} v_temp
fix              temp_ave all ave/time 1 1333 1333 v_temp
fix              vol_ave  all ave/time 1 ${log_freq} ${log_freq} v_vol
fix              vol_ave  all ave/time 1 1333 ${log_freq} v_vol
fix              vol_ave  all ave/time 1 1333 1333 v_vol
fix              lxx_ave  all ave/time 1 ${log_freq} ${log_freq} v_lxx
fix              lxx_ave  all ave/time 1 1333 ${log_freq} v_lxx
fix              lxx_ave  all ave/time 1 1333 1333 v_lxx
fix              lyy_ave  all ave/time 1 ${log_freq} ${log_freq} v_lyy
fix              lyy_ave  all ave/time 1 1333 ${log_freq} v_lyy
fix              lyy_ave  all ave/time 1 1333 1333 v_lyy
fix              lzz_ave  all ave/time 1 ${log_freq} ${log_freq} v_lzz
fix              lzz_ave  all ave/time 1 1333 ${log_freq} v_lzz
fix              lzz_ave  all ave/time 1 1333 1333 v_lzz

# Compute stress averages
compute          p all pressure 1_temp
variable         sxx equal -0.101325*c_p[1] #in MPa
variable         syy equal -0.101325*c_p[2] #in MPa
variable         szz equal -0.101325*c_p[3] #in MPa
variable         sxy equal -0.101325*c_p[4] #in MPa
variable         sxz equal -0.101325*c_p[5] #in MPa
variable         syz equal -0.101325*c_p[6] #in MPa

fix              sxx_ave all ave/time 1 ${log_freq} ${log_freq} v_sxx
fix              sxx_ave all ave/time 1 1333 ${log_freq} v_sxx
fix              sxx_ave all ave/time 1 1333 1333 v_sxx
fix              syy_ave all ave/time 1 ${log_freq} ${log_freq} v_syy
fix              syy_ave all ave/time 1 1333 ${log_freq} v_syy
fix              syy_ave all ave/time 1 1333 1333 v_syy
fix              szz_ave all ave/time 1 ${log_freq} ${log_freq} v_szz
fix              szz_ave all ave/time 1 1333 ${log_freq} v_szz
fix              szz_ave all ave/time 1 1333 1333 v_szz
fix              sxy_ave all ave/time 1 ${log_freq} ${log_freq} v_sxy
fix              sxy_ave all ave/time 1 1333 ${log_freq} v_sxy
fix              sxy_ave all ave/time 1 1333 1333 v_sxy
fix              sxz_ave all ave/time 1 ${log_freq} ${log_freq} v_sxz
fix              sxz_ave all ave/time 1 1333 ${log_freq} v_sxz
fix              sxz_ave all ave/time 1 1333 1333 v_sxz
fix              syz_ave all ave/time 1 ${log_freq} ${log_freq} v_syz
fix              syz_ave all ave/time 1 1333 ${log_freq} v_syz
fix              syz_ave all ave/time 1 1333 1333 v_syz

variable         ramp_temp equal ((step*dt/1000000)*v_hrate)+${stemp}
variable         ramp_temp equal ((step*dt/1000000)*v_hrate)+175

thermo_style     custom step v_Time temp press etotal ke pe etotal ecouple econserve evdwl ecoul epair elong ebond eangle edihed eimp                  density lx ly lz vol f_dens_ave f_lxx_ave f_lyy_ave f_lzz_ave f_vol_ave f_temp_ave v_ramp_temp                  v_sxx v_syy v_szz v_sxy v_sxz v_syz f_sxx_ave f_syy_ave f_szz_ave f_sxy_ave f_sxz_ave f_syz_ave


# Run in for loop
label loop
variable i loop ${Niter}
variable i loop 71
run ${write_steps} post no # 'post no' can be commented out to get output data between write intervals in the logfile
run 133333 post no 
