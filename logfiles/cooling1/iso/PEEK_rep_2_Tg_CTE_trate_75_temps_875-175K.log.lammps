fix 1 all npt temp 605.000665357167 595.000690000025 $(100*dt) iso ${press} ${press} $(1000*dt)
fix 1 all npt temp 605.000665357167 595.000690000025 100 iso ${press} ${press} $(1000*dt)
fix 1 all npt temp 605.000665357167 595.000690000025 100 iso 1 ${press} $(1000*dt)
fix 1 all npt temp 605.000665357167 595.000690000025 100 iso 1 1 $(1000*dt)
fix 1 all npt temp 605.000665357167 595.000690000025 100 iso 1 1 1000

run ${run_steps} post no
