fix 1 all npt temp 365.001256785759 355.001281428617 100 aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 365.001256785759 355.001281428617 100 aniso 1 ${press} $(1000*dt)
fix 1 all npt temp 365.001256785759 355.001281428617 100 aniso 1 1 $(1000*dt)
fix 1 all npt temp 365.001256785759 355.001281428617 100 aniso 1 1 1000

run ${run_steps} post no
run 133333 post no
