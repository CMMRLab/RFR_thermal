if "${run_steps} <= 0" then "jump SELF ramp_done"

variable Tstart equal ${stemp}+v_dTdS*step
variable Tstart equal 875+v_dTdS*step
variable Tfinal equal ${stemp}+v_dTdS*(step+v_run_steps)
variable Tfinal equal 875+v_dTdS*(step+v_run_steps)

fix 1 all npt temp ${Tstart} ${Tfinal} $(100*dt) aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 275.001478571482 ${Tfinal} $(100*dt) aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 275.001478571482 265.00150321434 $(100*dt) aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 275.001478571482 265.00150321434 100 aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 275.001478571482 265.00150321434 100 aniso 1 ${press} $(1000*dt)
fix 1 all npt temp 275.001478571482 265.00150321434 100 aniso 1 1 $(1000*dt)
fix 1 all npt temp 275.001478571482 265.00150321434 100 aniso 1 1 1000

run ${run_steps} post no
run 133333 post no
