fix 1 all npt temp 175.001725000062 ${Tfinal} $(100*dt) aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 175.001725000062 175 $(100*dt) aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 175.001725000062 175 100 aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 175.001725000062 175 100 aniso 1 ${press} $(1000*dt)
fix 1 all npt temp 175.001725000062 175 100 aniso 1 1 $(1000*dt)
fix 1 all npt temp 175.001725000062 175 100 aniso 1 1 1000

run ${run_steps} post no
run 23 post no
