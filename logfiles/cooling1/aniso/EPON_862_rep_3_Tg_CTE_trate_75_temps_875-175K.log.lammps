variable run_steps equal v_write_steps

if "${remaining_steps} < ${write_steps}" then    "variable run_steps delete"    "variable run_steps equal v_remaining_steps"

if "${run_steps} <= 0" then "jump SELF ramp_done"

variable Tstart equal ${stemp}+v_dTdS*step
variable Tstart equal 875+v_dTdS*step
variable Tfinal equal ${stemp}+v_dTdS*(step+v_run_steps)
variable Tfinal equal 875+v_dTdS*(step+v_run_steps)

fix 1 all npt temp ${Tstart} ${Tfinal} $(100*dt) aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 435.001084285753 ${Tfinal} $(100*dt) aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 435.001084285753 425.001108928611 $(100*dt) aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 435.001084285753 425.001108928611 100 aniso ${press} ${press} $(1000*dt)
fix 1 all npt temp 435.001084285753 425.001108928611 100 aniso 1 ${press} $(1000*dt)
fix 1 all npt temp 435.001084285753 425.001108928611 100 aniso 1 1 $(1000*dt)
fix 1 all npt temp 435.001084285753 425.001108928611 100 aniso 1 1 1000

run ${run_steps} post no
run 133333 post no
